# 统一行尾为 LF，避免跨平台 CRLF/LF 混乱
# Windows 检出后 .editorconfig + 此规则共同保证文件以 LF 存储
* text=auto eol=lf

# 源码与配置类文本（显式声明，确保各平台一致）
*.ts        text eol=lf
*.tsx        text eol=lf
*.js        text eol=lf
*.jsx        text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.json        text eol=lf
*.jsonc        text eol=lf
*.vue        text eol=lf
*.css        text eol=lf
*.scss        text eol=lf
*.html        text eol=lf
*.md        text eol=lf
*.mdx        text eol=lf
*.yml        text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.env        text eol=lf
*.env.*        text eol=lf

# 脚本与系统文件
*.sh        text eol=lf
*.bash        text eol=lf
*.zsh        text eol=lf
Dockerfile        text eol=lf
*.dockerfile        text eol=lf
.gitignore        text eol=lf
.gitattributes        text eol=lf
.editorconfig        text eol=lf
*.lock        text eol=lf

# Windows 特定脚本保留 CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# 二进制文件，不做行尾转换
